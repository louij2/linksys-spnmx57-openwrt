/dts-v1/;

#include "ipq5018.dtsi"
#include "ipq5018-mx-base.dtsi"

/ {
	model = "Linksys SPNMX57";
	compatible = "linksys,spnmx57", "qcom,ipq5018";
};

/*
* =================================================================
*  Unlike the SPNMX56, there is no QCA8337 and no QCA8081. A single
*  QCA8386 carries four QCA8084 EPHYs, reached over MDIO1, and hangs
*  off MAC1 on one forced 2.5G SGMII+ link. MAC0 and its internal GE
*  PHY exist in silicon but are not wired to any socket.
*
*     _______________________            ___________________________
*    |        IPQ5018        |          |          QCA8386          |
*    |                       |          |  port0 = CPU, 2500/full   |
*    | +------+   +--------+ |          |  port1 -- QCA8084 EPHY @1 |
*    | | MAC1 |---| Uniphy |-+-SGMII+---+  port2 -- QCA8084 EPHY @2 |
*    | +------+   +--------+ |  2.5G    |  port3 -- QCA8084 EPHY @3 |
*    |_______________________|          |  port4 -- QCA8084 EPHY @4 |
*                                       |___________________________|
*
*  Source: the vendor's own device tree, extracted from the stock OEM
*  image (see collected/vendor/ in the project repo). Values marked
*  [vendor] are lifted from it directly.
* =================================================================
*/

&ess_instance {
	/* [vendor] num_devices = <2>: the SoC ESS plus the QCA8386 */
	num_devices = <2>;

	/*
	 * [vendor] ess-switch1@1. The SSDK already carries full MHT
	 * (QCA8084/QCA8386) support: qca_mht_hw_init() clocks the chip,
	 * qca_mht_work_mode_init() applies the two mac modes below, and
	 * qca_mht_ephy_addr_get() reads the EPHY addresses back out of the
	 * strap register. So this node is a description, not a driver gap.
	 */
	switch1: ess-switch1@1 {
		compatible = "qcom,ess-switch-qca8386";
		device_id = <1>;
		switch_access_mode = "mdio";
		mdio-bus = <&mdio1>;

		/* [vendor] 0x0c = MAC_MODE_SGMII_PLUS on the uplink,
		 * 0xff = MAC_MODE_DISABLED on the unused second uplink */
		switch_mac_mode = <MAC_MODE_SGMII_PLUS>;
		switch_mac_mode1 = <MAC_MODE_DISABLED>;

		/* [vendor] port0 is the CPU port, ports 1-4 are LAN,
		 * and there is no hardware WAN port on this switch */
		switch_cpu_bmp = <ESS_PORT0>;
		switch_lan_bmp = <(ESS_PORT1 | ESS_PORT2 | ESS_PORT3 | ESS_PORT4)>;
		switch_wan_bmp = <0>;

		qcom,port_phyinfo {
			/* [vendor] CPU port, fixed 2.5G, no PHY */
			port@0 {
				port_id = <0>;
				forced-speed = <2500>;
				forced-duplex = <1>;
			};

			/* [vendor] the four QCA8084 EPHYs at MDIO 1..4 */
			/*
			 * [confirmed live] EPHY_CFG read back as 0x00318820 via the
			 * qca8084-preinit diagnostic (docs/uboot-qca8084-protocol.md):
			 * port0=addr0, port1=addr1, port2=addr2, port3=addr3.
			 * 0-indexed, NOT 1,2,3,4 as the vendor tree declares and as
			 * this file previously had it -- the vendor's own DTS values
			 * do not match what is actually strapped on this unit.
			 */
			port@1 {
				port_id = <1>;
				phy_address = <0>;
			};

			port@2 {
				port_id = <2>;
				phy_address = <1>;
			};

			port@3 {
				port_id = <3>;
				phy_address = <2>;
			};

			port@4 {
				port_id = <4>;
				phy_address = <3>;
			};
		};
	};
};

&switch {
	status = "okay";

	/* [vendor] SGMII+ toward the QCA8386, not SGMII_CHANNEL0 as on the 56 */
	switch_mac_mode = <MAC_MODE_SGMII_PLUS>;

	qcom,port_phyinfo {
		/*
		 * [vendor] MAC0 -> internal GE PHY at mdio0 address 7.
		 *
		 * This entry is REQUIRED even though MAC0 drives no socket. On
		 * ipq5018 chip_ver_get() finds no matching QCA_VER_* from the
		 * local-bus read and falls through to chip_is_scomphy(), which
		 * calls qca_detect_phyid(0) and reads the PHY at this address.
		 * Delete it and device 0 fails with -ENODEV too, exactly as
		 * device 1 does. The vendor tree declares it for the same reason.
		 */
		port@0 {
			port_id = <1>;
			mdiobus = <&mdio0>;
			phy_address = <7>;
		};

		/*
		 * [vendor] MAC1 -> UNIPHY1 -> QCA8386, forced 2.5G, no PHY.
		 *
		 * There is deliberately no port@0 here. The vendor declares one
		 * for MAC0 but defines no nss-dp node to go with it, so it is
		 * AP-MP03.1 reference board boilerplate rather than a real port.
		 */
		port@1 {
			port_id = <2>;
			forced-speed = <2500>;
			forced-duplex = <1>;
		};
	};
};

/*
 * The only data port. dp1 (MAC0) stays disabled: its GE PHY is real
 * silicon but is not wired to a socket on this board.
 */
&dp2 {
	status = "okay";

	label = "lan";

	nvmem-cells = <&hw_mac_addr 0>;
	nvmem-cell-names = "mac-address";
};

/*
 * mdio0 must be enabled even though MAC0 is not wired to a socket.
 *
 * The SSDK's ssdk_dt_get_mdio_node() finds its default bus by compatible
 * string, and mdio@88000 is the only node carrying "qcom,ipq40xx-mdio".
 * Leaving it disabled means no platform device is created for it, so
 * of_find_device_by_node() returns NULL and ssdk_dt_parse_default_mdio_bus()
 * fails with "cannot find platform device from mdio node" -- which aborts
 * the whole SSDK init ("no device found") and then oopses qca_nss_dp.
 *
 * The vendor tree has mdio@88000 status = "ok" for the same reason.
 */
&mdio0 {
	status = "okay";
};

&mdio1 {
	status = "okay";

	/*
	 * Read-only diagnostic preinit: reads EPHY_CFG and logs each port's
	 * current strap address to the kernel log at probe time, using the
	 * protocol reverse engineered from the vendor U-Boot (see
	 * docs/uboot-qca8084-protocol.md). Writes nothing. Needs
	 * 0919-net-mdio-ipq4019-add-QCA8084-preinit-for-SPNMX57.patch.
	 */
	qcom,qca8084-preinit;

	pinctrl-0 = <&mdio1_pins>;
	pinctrl-names = "default";

	/*
	 * [vendor] phy-reset-gpio = <&tlmm 0x18 0x00>, i.e. gpio24, which is
	 * the QCA8386 package reset. The 56 uses gpio39 here for its QCA8337,
	 * which is a different line entirely and does nothing useful on this
	 * board.
	 *
	 * [GUESS] the polarity. The vendor flag cell is 0, but vendor code
	 * commonly ignores the flag and pulses the line low then high, so
	 * ACTIVE_LOW is what matches the behaviour. If the package never
	 * comes out of reset, try ACTIVE_HIGH.
	 */
	reset-gpios = <&tlmm 24 GPIO_ACTIVE_LOW>;
	reset-delay-us = <10000>;
	reset-post-delay-us = <50000>;

	/*
	 * DIAGNOSTIC MDIO SCAN -- remove once the bus map is known.
	 *
	 * of_mdiobus_register() walks explicit-reg children and, when
	 * get_phy_device() returns -ENODEV, prints
	 *   mdio_bus 90000.mdio-1: MDIO device at address N is missing.
	 * and continues. Any address that DOES answer gets a real phy_device
	 * with a readable /sys/bus/mdio_bus/devices/90000.mdio-1:NN/phy_id.
	 *
	 * This runs before qca-ssdk loads, so it cannot race it, and it is the
	 * only SSDK-independent way to learn where the QCA8084 EPHYs actually
	 * sit on a cold chip. Userspace cannot answer it: this kernel has
	 * CONFIG_DEVMEM=n, no ftrace and no mdio-tools.
	 */
	ephy00: ethernet-phy@0 {
		reg = <0x00>;
	};

	ephy01: ethernet-phy@1 {
		reg = <0x01>;
	};

	ephy02: ethernet-phy@2 {
		reg = <0x02>;
	};

	ephy03: ethernet-phy@3 {
		reg = <0x03>;
	};

	ephy04: ethernet-phy@4 {
		reg = <0x04>;
	};

	ephy05: ethernet-phy@5 {
		reg = <0x05>;
	};

	ephy06: ethernet-phy@6 {
		reg = <0x06>;
	};

	ephy07: ethernet-phy@7 {
		reg = <0x07>;
	};

	ephy08: ethernet-phy@8 {
		reg = <0x08>;
	};

	ephy09: ethernet-phy@9 {
		reg = <0x09>;
	};

	ephy0a: ethernet-phy@a {
		reg = <0x0a>;
	};

	ephy0b: ethernet-phy@b {
		reg = <0x0b>;
	};

	ephy0c: ethernet-phy@c {
		reg = <0x0c>;
	};

	ephy0d: ethernet-phy@d {
		reg = <0x0d>;
	};

	ephy0e: ethernet-phy@e {
		reg = <0x0e>;
	};

	ephy0f: ethernet-phy@f {
		reg = <0x0f>;
	};

	ephy10: ethernet-phy@10 {
		reg = <0x10>;
	};

	ephy11: ethernet-phy@11 {
		reg = <0x11>;
	};

	ephy12: ethernet-phy@12 {
		reg = <0x12>;
	};

	ephy13: ethernet-phy@13 {
		reg = <0x13>;
	};

	ephy14: ethernet-phy@14 {
		reg = <0x14>;
	};

	ephy15: ethernet-phy@15 {
		reg = <0x15>;
	};

	ephy16: ethernet-phy@16 {
		reg = <0x16>;
	};

	ephy17: ethernet-phy@17 {
		reg = <0x17>;
	};

	ephy18: ethernet-phy@18 {
		reg = <0x18>;
	};

	ephy19: ethernet-phy@19 {
		reg = <0x19>;
	};

	ephy1a: ethernet-phy@1a {
		reg = <0x1a>;
	};

	ephy1b: ethernet-phy@1b {
		reg = <0x1b>;
	};

	ephy1c: ethernet-phy@1c {
		reg = <0x1c>;
	};

	ephy1d: ethernet-phy@1d {
		reg = <0x1d>;
	};

	ephy1e: ethernet-phy@1e {
		reg = <0x1e>;
	};

	ephy1f: ethernet-phy@1f {
		reg = <0x1f>;
	};

};

&pcie0_phy {
	status = "okay";
};

&pcie0 {
	status = "okay";

	perst-gpios = <&tlmm 15 GPIO_ACTIVE_LOW>;

	pcie@0 {
		wifi@0,0 {
			status = "okay";

			/* QCN9074: ath11k lacks DT compatible for PCI cards */
			compatible = "pci17cb,1104";
			reg = <0x00010000 0 0 0 0>;

			/*
			 * Deliberately the SPNMX56 calibration variant. Wi-Fi is
			 * already known good on this exact hardware with it, and a
			 * SPNMX57 variant does not exist in firmware_qca-wireless
			 * yet, so using one would silently fall back to a generic
			 * board file. Keep the known quantity while Ethernet is
			 * the thing under test.
			 */
			qcom,ath11k-calibration-variant = "Linksys-SPNMX56";
		};
	};
};
&q6v5_wcss {
	status = "okay";

	memory-region = <&q6_mem_regions>;
	firmware-name = "ath11k/IPQ5018/hw1.0/q6_fw.mdt",
			"ath11k/IPQ5018/hw1.0/m3_fw.mdt";

	// IPQ5018
	q6_wcss_pd1: pd-1 {
		firmware-name = "ath11k/IPQ5018/hw1.0/q6_fw.mdt";

		resets =
			<&gcc GCC_WCSSAON_RESET>,
			<&gcc GCC_WCSS_BCR>,
			<&gcc GCC_CE_BCR>;
		reset-names =
			"wcss_aon_reset",
			"wcss_reset",
			"ce_reset";

		clocks =
			<&gcc GCC_WCSS_AHB_S_CLK>,
			<&gcc GCC_WCSS_ACMT_CLK>,
			<&gcc GCC_WCSS_AXI_M_CLK>;
		clock-names =
			"gcc_wcss_ahb_s_clk",
			"gcc_wcss_acmt_clk",
			"gcc_wcss_axi_m_clk";

		interrupts-extended =
			<&wcss_smp2p_in 8 0>,
			<&wcss_smp2p_in 9 0>,
			<&wcss_smp2p_in 12 0>,
			<&wcss_smp2p_in 11 0>;
		interrupt-names =
			"fatal",
			"ready",
			"spawn-ack",
			"stop-ack";

		qcom,smem-states =
			<&wcss_smp2p_out 8>,
			<&wcss_smp2p_out 9>,
			<&wcss_smp2p_out 10>;
		qcom,smem-state-names =
			"shutdown",
			"stop",
			"spawn";
	};
};

&wifi0 {
	// IPQ5018
	qcom,rproc = <&q6_wcss_pd1>;
	qcom,ath11k-calibration-variant = "Linksys-SPNMX56";
	qcom,ath11k-fw-memory-mode = <1>;
	qcom,bdf-addr = <0x4c400000>;

	status = "okay";
};
