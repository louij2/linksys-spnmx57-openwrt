/dts-v1/;

#include "ipq5018.dtsi"
#include "ipq5018-mx-base.dtsi"

/ {
	model = "Linksys SPNMX57";
	compatible = "linksys,spnmx57", "qcom,ipq5018";
};

/*
* =================================================================
*  Unlike the SPNMX56, there is no QCA8337 and no QCA8081. A single
*  QCA8386 carries four QCA8084 EPHYs, reached over MDIO1, and hangs
*  off MAC1 on one forced 2.5G SGMII+ link. MAC0 and its internal GE
*  PHY exist in silicon but are not wired to any socket.
*
*     _______________________            ___________________________
*    |        IPQ5018        |          |          QCA8386          |
*    |                       |          |  port0 = CPU, 2500/full   |
*    | +------+   +--------+ |          |  port1 -- QCA8084 EPHY @1 |
*    | | MAC1 |---| Uniphy |-+-SGMII+---+  port2 -- QCA8084 EPHY @2 |
*    | +------+   +--------+ |  2.5G    |  port3 -- QCA8084 EPHY @3 |
*    |_______________________|          |  port4 -- QCA8084 EPHY @4 |
*                                       |___________________________|
*
*  Source: the vendor's own device tree, extracted from the stock OEM
*  image (see collected/vendor/ in the project repo). Values marked
*  [vendor] are lifted from it directly.
* =================================================================
*/

&ess_instance {
	/* [vendor] num_devices = <2>: the SoC ESS plus the QCA8386 */
	num_devices = <2>;

	/*
	 * [vendor] ess-switch1@1. The SSDK already carries full MHT
	 * (QCA8084/QCA8386) support: qca_mht_hw_init() clocks the chip,
	 * qca_mht_work_mode_init() applies the two mac modes below, and
	 * qca_mht_ephy_addr_get() reads the EPHY addresses back out of the
	 * strap register. So this node is a description, not a driver gap.
	 */
	switch1: ess-switch1@1 {
		compatible = "qcom,ess-switch-qca8386";
		device_id = <1>;
		switch_access_mode = "mdio";
		mdio-bus = <&mdio1>;

		/* [vendor] 0x0c = MAC_MODE_SGMII_PLUS on the uplink,
		 * 0xff = MAC_MODE_DISABLED on the unused second uplink */
		switch_mac_mode = <MAC_MODE_SGMII_CHANNEL0>;
		switch_mac_mode1 = <MAC_MODE_DISABLED>;

		/* [vendor] port0 is the CPU port, ports 1-4 are LAN,
		 * and there is no hardware WAN port on this switch */
		switch_cpu_bmp = <ESS_PORT0>;
		switch_lan_bmp = <(ESS_PORT1 | ESS_PORT2 | ESS_PORT3 | ESS_PORT4)>;
		switch_wan_bmp = <0>;

		qcom,port_phyinfo {
			/* [vendor] CPU port, fixed 2.5G, no PHY */
			port@0 {
				port_id = <0>;
				forced-speed = <1000>;
				forced-duplex = <1>;
			};

			/* [vendor] the four QCA8084 EPHYs at MDIO 1..4 */
			/*
			 * Back to the vendor's 1,2,3,4, and this time for a reason
			 * rather than by inheritance.
			 *
			 * EPHY_CFG does read 0x00318820 on a cold chip, which decodes
			 * to strap addresses 0,1,2,3, and that is what this file said
			 * for a while. But the strap is only the power-on default.
			 * Ghidra decompilation of the vendor U-Boot shows FUN_4a94c7d0
			 * overwriting EPHY_CFG's low 20 bits with a hardcoded 0x20c41
			 * immediately after bring-up, which is the same four 5-bit
			 * fields holding 1,2,3,4. The preinit patch now does the same
			 * write, so 1,2,3,4 is where the EPHYs actually end up.
			 *
			 * Corroborated by the vendor's own in-use address bitmap in
			 * that function, 0xffff001e: bits 1-4 marked taken for these
			 * four EPHYs, and bits 16-31 for the switch register window,
			 * which is exactly the 0x10-0x1f block seen answering on the
			 * live bus.
			 */
			port@1 {
				port_id = <1>;
				phy_address = <1>;
			};

			port@2 {
				port_id = <2>;
				phy_address = <2>;
			};

			port@3 {
				port_id = <3>;
				phy_address = <3>;
			};

			port@4 {
				port_id = <4>;
				phy_address = <4>;
			};
		};
	};
};

&switch {
	status = "okay";

	/* [vendor] SGMII+ toward the QCA8386, not SGMII_CHANNEL0 as on the 56 */
	switch_mac_mode = <MAC_MODE_SGMII_CHANNEL0>;

	/*
	 * The port bitmap for the SoC ESS. Without these the RX MAC is never
	 * enabled and nothing is ever received.
	 *
	 * ssdk_dt_parse_port_bmp() reads switch_cpu_bmp, switch_lan_bmp and
	 * switch_wan_bmp with a single combined condition, so all three have to
	 * be present or none of them are used; it then sets the working bitmap
	 * to lan_bmp | wan_bmp. Declaring none of them left it at zero, which
	 * logs the mild-looking "port_bmp doesn't exist!" at boot and then bites
	 * much later: adpt_mp_port_netdev_change_notify() checks the netdev's
	 * port against that bitmap, fails it with
	 *
	 *   adpt_mp_port_netdev_change_notify: netdev change notify with incorrect port 0
	 *   ssdk_dev_event: netdev change notify failed
	 *
	 * and returns before reaching adpt_mp_port_rxmac_status_set(A_TRUE).
	 * The transmit path is unaffected, which is exactly the symptom seen
	 * with a live cable in port 1: tx_packets climbing, rx_packets stuck
	 * at 0.
	 *
	 * Port 1 is MAC0's internal GE PHY, port 2 is MAC1 into the QCA8386.
	 * There is no CPU port on this side of the link.
	 */
	switch_cpu_bmp = <0>;
	switch_lan_bmp = <(ESS_PORT1 | ESS_PORT2)>;
	switch_wan_bmp = <0>;

	qcom,port_phyinfo {
		/*
		 * [vendor] MAC0 -> internal GE PHY at mdio0 address 7.
		 *
		 * This entry is REQUIRED even though MAC0 drives no socket. On
		 * ipq5018 chip_ver_get() finds no matching QCA_VER_* from the
		 * local-bus read and falls through to chip_is_scomphy(), which
		 * calls qca_detect_phyid(0) and reads the PHY at this address.
		 * Delete it and device 0 fails with -ENODEV too, exactly as
		 * device 1 does. The vendor tree declares it for the same reason.
		 */
		port@0 {
			port_id = <1>;
			mdiobus = <&mdio0>;
			phy_address = <7>;
		};

		/*
		 * [vendor] MAC1 -> UNIPHY1 -> QCA8386, forced 2.5G, no PHY.
		 *
		 * There is deliberately no port@0 here. The vendor declares one
		 * for MAC0 but defines no nss-dp node to go with it, so it is
		 * AP-MP03.1 reference board boilerplate rather than a real port.
		 */
		port@1 {
			port_id = <2>;
			forced-speed = <1000>;
			forced-duplex = <1>;
		};
	};
};

/*
 * The only data port. dp1 (MAC0) stays disabled: its GE PHY is real
 * silicon but is not wired to a socket on this board.
 */
&dp2 {
	status = "okay";

	label = "lan";

	nvmem-cells = <&hw_mac_addr 0>;
	nvmem-cell-names = "mac-address";

	/*
	 * There is no PHY on this link to connect to. MAC1 goes out over
	 * UNIPHY1 as SGMII+ straight into the QCA8386's CPU port, so nss-dp
	 * has to be told the link parameters rather than negotiating them:
	 *
	 *   nss-dp 39d00000.dp2 lan: failed to connect to phy device
	 *   nss-dp 39d00000.dp2: probe with driver nss-dp failed with error -14
	 *
	 * The speed here is 1000 rather than the 2500 this link actually runs
	 * at, and that is deliberate. of_phy_register_fixed_link() goes through
	 * the kernel's software PHY, which only decodes 10, 100 and 1000:
	 *
	 *   swphy: unknown speed
	 *   dp2: fail to register fixed-link: -22
	 *
	 * The real rate is not set here anyway. qca-ssdk drives it from
	 * switch_mac_mode = MAC_MODE_SGMII_PLUS and the qca8386 port@0 entry
	 * carrying forced-speed = <2500>, forced-duplex = <1>. This subnode
	 * exists only to give nss-dp a link to attach to.
	 */
	fixed-link {
		speed = <1000>;
		full-duplex;
	};
};

/*
 * mdio0 must be enabled even though MAC0 is not wired to a socket.
 *
 * The SSDK's ssdk_dt_get_mdio_node() finds its default bus by compatible
 * string, and mdio@88000 is the only node carrying "qcom,ipq40xx-mdio".
 * Leaving it disabled means no platform device is created for it, so
 * of_find_device_by_node() returns NULL and ssdk_dt_parse_default_mdio_bus()
 * fails with "cannot find platform device from mdio node" -- which aborts
 * the whole SSDK init ("no device found") and then oopses qca_nss_dp.
 *
 * The vendor tree has mdio@88000 status = "ok" for the same reason.
 */
&mdio0 {
	status = "okay";
};

&mdio1 {
	status = "okay";

	/*
	 * Read-only diagnostic preinit: reads EPHY_CFG and logs each port's
	 * current strap address to the kernel log at probe time, using the
	 * protocol reverse engineered from the vendor U-Boot (see
	 * docs/uboot-qca8084-protocol.md). Writes nothing. Needs
	 * 0919-net-mdio-ipq4019-add-QCA8084-preinit-for-SPNMX57.patch.
	 */
	qcom,qca8084-preinit;

	/* TEST BUILD ONLY: full bring-up instrumentation on. Drop this
	 * line again before cutting another release image. */
	qcom,qca8084-preinit-debug;

	/* 2026-09-04 bisect: reproduce the preinit an EPHY was last seen linked with:
	 * the U-Boot software trims on, the analogue block (hw_init/PLL/LDO) off. */
	qcom,qca8084-software-trims;

	pinctrl-0 = <&mdio1_pins>;
	pinctrl-names = "default";

	/*
	 * [vendor] phy-reset-gpio = <&tlmm 0x18 0x00>, i.e. gpio24, which is
	 * the QCA8386 package reset. The 56 uses gpio39 here for its QCA8337,
	 * which is a different line entirely and does nothing useful on this
	 * board.
	 *
	 * [GUESS] the polarity. The vendor flag cell is 0, but vendor code
	 * commonly ignores the flag and pulses the line low then high, so
	 * ACTIVE_LOW is what matches the behaviour. If the package never
	 * comes out of reset, try ACTIVE_HIGH.
	 */
	/*
	 * Deliberately NOT called "reset-gpios". __mdiobus_register() claims
	 * and pulses a property of that name itself, and preinit now runs
	 * before registration, so leaving it as "reset-gpios" means the
	 * package is still held in reset for the whole of preinit (every
	 * transaction reads 0xffffffff) and is then reset a second time
	 * afterwards, throwing away the clock/reset/calibration work.
	 * Under the private name, the preinit code owns the line and
	 * __mdiobus_register() leaves it alone.
	 */
	qca8084-reset-gpios = <&tlmm 24 GPIO_ACTIVE_LOW>;
	reset-delay-us = <10000>;
	reset-post-delay-us = <50000>;

	/*
	 * Real phy nodes for the four QCA8084 EPHYs.
	 *
	 * These are not the old diagnostic stubs, which existed only to make
	 * of_mdiobus_register() probe every address and print what was missing.
	 * These four are the actual PHYs, and they are needed because qca-ssdk
	 * looks up a Linux phy_device for each port's phy_address and refuses
	 * to continue without one:
	 *
	 *   hsl_phy_phydev_get: ERROR: phy_addr 1 phydev is NULL
	 *
	 * They answer now, reporting PHY ID 0x004dd180 (QCA8084_PHY), which is
	 * why declaring them is finally meaningful rather than noise.
	 */
	ephy01: ethernet-phy@1 {
		reg = <0x01>;
	};

	ephy02: ethernet-phy@2 {
		reg = <0x02>;
	};

	ephy03: ethernet-phy@3 {
		reg = <0x03>;
	};

	ephy04: ethernet-phy@4 {
		reg = <0x04>;
	};

};

&pcie0_phy {
	status = "okay";
};

&pcie0 {
	status = "okay";

	perst-gpios = <&tlmm 15 GPIO_ACTIVE_LOW>;

	pcie@0 {
		wifi@0,0 {
			status = "okay";

			/* QCN9074: ath11k lacks DT compatible for PCI cards */
			compatible = "pci17cb,1104";
			reg = <0x00010000 0 0 0 0>;

			/*
			 * Deliberately the SPNMX56 calibration variant. Wi-Fi is
			 * already known good on this exact hardware with it, and a
			 * SPNMX57 variant does not exist in firmware_qca-wireless
			 * yet, so using one would silently fall back to a generic
			 * board file. Keep the known quantity while Ethernet is
			 * the thing under test.
			 */
			qcom,ath11k-calibration-variant = "Linksys-SPNMX56";
		};
	};
};
&q6v5_wcss {
	status = "okay";

	memory-region = <&q6_mem_regions>;
	firmware-name = "ath11k/IPQ5018/hw1.0/q6_fw.mdt",
			"ath11k/IPQ5018/hw1.0/m3_fw.mdt";

	// IPQ5018
	q6_wcss_pd1: pd-1 {
		firmware-name = "ath11k/IPQ5018/hw1.0/q6_fw.mdt";

		resets =
			<&gcc GCC_WCSSAON_RESET>,
			<&gcc GCC_WCSS_BCR>,
			<&gcc GCC_CE_BCR>;
		reset-names =
			"wcss_aon_reset",
			"wcss_reset",
			"ce_reset";

		clocks =
			<&gcc GCC_WCSS_AHB_S_CLK>,
			<&gcc GCC_WCSS_ACMT_CLK>,
			<&gcc GCC_WCSS_AXI_M_CLK>;
		clock-names =
			"gcc_wcss_ahb_s_clk",
			"gcc_wcss_acmt_clk",
			"gcc_wcss_axi_m_clk";

		interrupts-extended =
			<&wcss_smp2p_in 8 0>,
			<&wcss_smp2p_in 9 0>,
			<&wcss_smp2p_in 12 0>,
			<&wcss_smp2p_in 11 0>;
		interrupt-names =
			"fatal",
			"ready",
			"spawn-ack",
			"stop-ack";

		qcom,smem-states =
			<&wcss_smp2p_out 8>,
			<&wcss_smp2p_out 9>,
			<&wcss_smp2p_out 10>;
		qcom,smem-state-names =
			"shutdown",
			"stop",
			"spawn";
	};
};

&wifi0 {
	// IPQ5018
	qcom,rproc = <&q6_wcss_pd1>;
	qcom,ath11k-calibration-variant = "Linksys-SPNMX56";
	qcom,ath11k-fw-memory-mode = <1>;
	qcom,bdf-addr = <0x4c400000>;

	status = "okay";
};
