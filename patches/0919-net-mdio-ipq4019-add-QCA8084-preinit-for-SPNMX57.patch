+	 * read". We do not, so a nonsense value here may be a clock artefact
+	 * rather than a different chip.
+	 */
+
+	/* Autonegotiation needs seconds, not milliseconds. Sampling only once
+	 * straight after the resets reports "link down" on every port whether
+	 * or not a cable is in, which is worse than not sampling at all.
+	 */
+	qca8084_sample_ephy_link(bus, "post-init");
+	msleep(3000);
+	qca8084_sample_ephy_link(bus, "at +3s");
+	msleep(3000);
+	qca8084_sample_ephy_link(bus, "at +6s");
