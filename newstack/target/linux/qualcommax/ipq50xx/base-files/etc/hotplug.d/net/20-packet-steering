#!/bin/sh
# Spread network RX processing across all cores (RPS).
#
# This device has a single-queue conduit and no NSS offload, so without this one
# core does every packet while the other sits idle: IRQ 22 (eth0) showed 1.4M
# interrupts on cpu0 and exactly 0 on cpu1. Measured over WiFi 6 to an iPhone,
# enabling this took the download from 257 to 485 Mbit/s.
#
# NOTE: the uci option network.globals.packet_steering does NOT work on this
# build - netifd contains no rps_cpus code at all - so it is done here instead.
[ "$ACTION" = "add" ] || exit 0
[ -n "$DEVICENAME" ] || exit 0

NCPU=$(grep -c ^processor /proc/cpuinfo)
[ "$NCPU" -gt 1 ] || exit 0
ALL=$(( (1 << NCPU) - 1 ))

case "$DEVICENAME" in
	eth0)              MASK=$(( ALL & ~1 )) ;;
	lan*|wan|phy*-ap*) MASK=$ALL ;;
	*)                 exit 0 ;;
esac

for q in /sys/class/net/"$DEVICENAME"/queues/rx-*; do
	[ -w "$q/rps_cpus" ] && printf '%x' "$MASK" > "$q/rps_cpus"
done
exit 0
