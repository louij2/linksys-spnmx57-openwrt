/dts-v1/;

#include "ipq5018.dtsi"
#include "ipq5018-ess.dtsi"
#include "ipq5018-mx-base.dtsi"

#include <dt-bindings/clock/qcom,qca8k-nsscc.h>
#include <dt-bindings/reset/qcom,qca8k-nsscc.h>
#include <dt-bindings/net/qcom,qca808x.h>

/ {
	model = "Linksys SPNMX57";
	compatible = "linksys,spnmx57", "qcom,ipq5018";

	chosen {
		bootargs-append = " root=/dev/ubiblock0_0 coherent_pool=2M";
		stdout-path = "serial0:115200n8";
	};

	/*
	 * Clock inputs of the QCA8386's internal NSS clock controller.
	 *
	 * XO is a real 50 MHz reference. The uniphy rates are generated inside
	 * the chip by the SerDes PLL (brought up over MDIO by the QCA8084
	 * package/serdes driver); they are declared as fixed-clocks purely so
	 * the CCF can select mux parents and compute RCG dividers.
	 *
	 * Load-bearing: XO (all GEPHY sys clocks derive from it, and it is the
	 * only clock nss_cc_qca8k_probe() enables) and UNIPHY1_TX312P5M (the
	 * switch_core/apb_bridge mux must reach 312.5 MHz, which the package
	 * driver requests explicitly).
	 */
	qca8084_xo: clock-qca8084-xo {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <50000000>;
	};

	qca8k_uniphy0_rx: clock-qca8k-uniphy0-rx {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <125000000>;
	};

	qca8k_uniphy0_tx: clock-qca8k-uniphy0-tx {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <125000000>;
	};

	qca8k_uniphy1_rx: clock-qca8k-uniphy1-rx {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <312500000>;
	};

	qca8k_uniphy1_tx: clock-qca8k-uniphy1-tx {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <312500000>;
	};

	qca8k_uniphy1_rx312p5m: clock-qca8k-uniphy1-rx312p5m {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <312500000>;
	};

	qca8k_uniphy1_tx312p5m: clock-qca8k-uniphy1-tx312p5m {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <312500000>;
	};
};

/*
 * Phase 2d (new DSA stack): QCA8386 switch with its four integrated QCA8084
 * 2.5G EPHYs exposed as lan1-4 DSA user ports.
 *
 * CPU port 0 uplinks to the SoC gmac1 at forced 2.5G SGMII+. The switch, the
 * NSS clock controller and the PHY package all sit behind the same indirect
 * MDIO window on mdio1 (page @ phy 0x18 reg 0x0c, data @ phy 0x10|r2).
 *
 * gpio24 (the QCA8386 package reset) is owned SOLELY by the nsscc node - the
 * switch node must not also claim it or the second devm_gpiod_get() gets -EBUSY.
 */

&uniphy0 {
	status = "okay";

	assigned-clocks = <&uniphy0 UNIPHY_CLK_REF>;
	assigned-clock-rates = <UNIPHY_REFCLK_50MHZ>;
};

/* MAC1 ---SGMII+ 2.5G---> QCA8386 CPU port (port 0) */
&gmac1 {
	status = "okay";

	phy-mode = "2500base-x";

	nvmem-cells = <&hw_mac_addr 0>;
	nvmem-cell-names = "mac-address";

	fixed-link {
		speed = <2500>;
		full-duplex;
		pause;
	};
};

&mdio0 {
	status = "okay";
};

&mdio1 {
	status = "okay";

	pinctrl-0 = <&mdio1_pins>;
	pinctrl-names = "default";

	/*
	 * The QCA8386's internal NSS clock/reset controller. Clocks MUST be in
	 * the driver's enum order (DT_XO first) and MUST NOT have clock-names:
	 * nss_cc_qca8k_probe() does clk_get(dev, NULL), i.e. index 0 = XO.
	 */
	qca8k_nsscc: clock-controller@18 {
		compatible = "qcom,qca8084-nsscc";
		reg = <0x18>;
		reset-gpios = <&tlmm 24 GPIO_ACTIVE_LOW>;
		#clock-cells = <1>;
		#reset-cells = <1>;
		#power-domain-cells = <1>;

		clocks = <&qca8084_xo>,
			 <&qca8k_uniphy0_rx>,
			 <&qca8k_uniphy0_tx>,
			 <&qca8k_uniphy1_rx>,
			 <&qca8k_uniphy1_tx>,
			 <&qca8k_uniphy1_rx312p5m>,
			 <&qca8k_uniphy1_tx312p5m>;
	};

	/*
	 * The four integrated QCA8084 EPHYs as a package. package-mode 1 is
	 * switch mode (PCS1 SGMII MAC / PCS0 SGMII MAC), which is why there is
	 * no xpcs-phy@7 and no qcom,xpcs-channel here - those are 10G-QXGMII
	 * (mode 0) only.
	 */
	ethernet-phy-package@1 {
		compatible = "qcom,qca8084-package";
		reg = <1>;
		#address-cells = <1>;
		#size-cells = <0>;

		clocks = <&qca8k_nsscc NSS_CC_APB_BRIDGE_CLK>,
			 <&qca8k_nsscc NSS_CC_AHB_CLK>,
			 <&qca8k_nsscc NSS_CC_SEC_CTRL_AHB_CLK>,
			 <&qca8k_nsscc NSS_CC_TLMM_CLK>,
			 <&qca8k_nsscc NSS_CC_TLMM_AHB_CLK>,
			 <&qca8k_nsscc NSS_CC_CNOC_AHB_CLK>,
			 <&qca8k_nsscc NSS_CC_MDIO_AHB_CLK>,
			 <&qca8k_nsscc NSS_CC_MDIO_MASTER_AHB_CLK>,
			 <&qca8k_nsscc NSS_CC_SWITCH_CORE_CLK>;
		/* switch_core and mdio_master_ahb MUST be claimed: the driver
		 * looks up all nine, and any branch with no consumer is turned
		 * off by clk_disable_unused() - which silently kills the switch
		 * datapath in switch mode.
		 */
		clock-names = "apb_bridge", "ahb", "sec_ctrl_ahb",
			      "tlmm", "tlmm_ahb", "cnoc_ahb", "mdio_ahb",
			      "mdio_master_ahb", "switch_core";
		resets = <&qca8k_nsscc NSS_CC_GEPHY_FULL_ARES>;

		qcom,package-mode = <QCA808X_PCS1_SGMII_MAC_PCS0_SGMII_MAC>;
		qcom,phy-addr-fixup = <1 2 3 4 5 6 7>;

		ephy1: ethernet-phy@1 {
			compatible = "ethernet-phy-id004d.d180";
			reg = <1>;
			clocks = <&qca8k_nsscc NSS_CC_GEPHY0_SYS_CLK>;
			resets = <&qca8k_nsscc NSS_CC_GEPHY0_SYS_ARES>;
		};

		ephy2: ethernet-phy@2 {
			compatible = "ethernet-phy-id004d.d180";
			reg = <2>;
			clocks = <&qca8k_nsscc NSS_CC_GEPHY1_SYS_CLK>;
			resets = <&qca8k_nsscc NSS_CC_GEPHY1_SYS_ARES>;
		};

		ephy3: ethernet-phy@3 {
			compatible = "ethernet-phy-id004d.d180";
			reg = <3>;
			clocks = <&qca8k_nsscc NSS_CC_GEPHY2_SYS_CLK>;
			resets = <&qca8k_nsscc NSS_CC_GEPHY2_SYS_ARES>;
		};

		ephy4: ethernet-phy@4 {
			compatible = "ethernet-phy-id004d.d180";
			reg = <4>;
			clocks = <&qca8k_nsscc NSS_CC_GEPHY3_SYS_CLK>;
			resets = <&qca8k_nsscc NSS_CC_GEPHY3_SYS_ARES>;
		};

		/* PCS1 SGMII+ carrying the MAC0 (CPU) uplink. */
		pcs-phy@6 {
			compatible = "qcom,qca8k-pcs-phy";
			reg = <6>;
			clocks = <&qca8k_nsscc NSS_CC_SRDS1_SYS_CLK>,
				 <&qca8k_uniphy1_tx312p5m>,
				 <&qca8k_uniphy1_rx312p5m>;
			clock-names = "pcs", "pcs_rx_root", "pcs_tx_root";
			resets = <&qca8k_nsscc NSS_CC_SRDS1_SYS_ARES>;
		};
	};

	/* QCA8386 switch: register window at pseudo-PHY 0x10. */
	switch@10 {
		compatible = "qca,qca8386";
		reg = <0x10>;
		#address-cells = <1>;
		#size-cells = <0>;

		/* The switch core and each MAC port come out of the package
		 * reset held in reset - their registers read back 0 and writes
		 * are dropped. The vendor SSDK pulses exactly this set in
		 * qca_mht_switch_reset() immediately before qca_switch_init().
		 */
		resets = <&qca8k_nsscc NSS_CC_SWITCH_CORE_ARES>,
			 <&qca8k_nsscc NSS_CC_MAC0_TX_ARES>,
			 <&qca8k_nsscc NSS_CC_MAC0_RX_ARES>,
			 <&qca8k_nsscc NSS_CC_MAC1_TX_ARES>,
			 <&qca8k_nsscc NSS_CC_MAC1_RX_ARES>,
			 <&qca8k_nsscc NSS_CC_MAC2_TX_ARES>,
			 <&qca8k_nsscc NSS_CC_MAC2_RX_ARES>,
			 <&qca8k_nsscc NSS_CC_MAC3_TX_ARES>,
			 <&qca8k_nsscc NSS_CC_MAC3_RX_ARES>,
			 <&qca8k_nsscc NSS_CC_MAC4_TX_ARES>,
			 <&qca8k_nsscc NSS_CC_MAC4_RX_ARES>,
			 <&qca8k_nsscc NSS_CC_MAC5_TX_ARES>,
			 <&qca8k_nsscc NSS_CC_MAC5_RX_ARES>;
		reset-names = "switch_core",
			      "mac0_tx", "mac0_rx",
			      "mac1_tx", "mac1_rx",
			      "mac2_tx", "mac2_rx",
			      "mac3_tx", "mac3_rx",
			      "mac4_tx", "mac4_rx",
			      "mac5_tx", "mac5_rx";

		/* Per-port datapath clocks. Nothing else claims these, so
		 * clk_disable_unused() would otherwise gate them and no frame
		 * would ever move. This is the switch-mode subset of the
		 * vendor's ssdk_mht_gcc_clock_init(): MAC0 gets its SerDes
		 * (UNIPHY1) clocks, the four user ports get their internal
		 * GEPHY clocks. Four clocks per port, tx then rx - the driver
		 * indexes them as port * 4.
		 */
		clocks = <&qca8k_nsscc NSS_CC_MAC0_TX_CLK>,
			 <&qca8k_nsscc NSS_CC_MAC0_RX_CLK>,
			 <&qca8k_nsscc NSS_CC_MAC0_TX_SRDS1_CLK>,
			 <&qca8k_nsscc NSS_CC_MAC0_RX_SRDS1_CLK>,
			 <&qca8k_nsscc NSS_CC_MAC1_TX_CLK>,
			 <&qca8k_nsscc NSS_CC_MAC1_RX_CLK>,
			 <&qca8k_nsscc NSS_CC_MAC1_GEPHY0_TX_CLK>,
			 <&qca8k_nsscc NSS_CC_MAC1_GEPHY0_RX_CLK>,
			 <&qca8k_nsscc NSS_CC_MAC2_TX_CLK>,
			 <&qca8k_nsscc NSS_CC_MAC2_RX_CLK>,
			 <&qca8k_nsscc NSS_CC_MAC2_GEPHY1_TX_CLK>,
			 <&qca8k_nsscc NSS_CC_MAC2_GEPHY1_RX_CLK>,
			 <&qca8k_nsscc NSS_CC_MAC3_TX_CLK>,
			 <&qca8k_nsscc NSS_CC_MAC3_RX_CLK>,
			 <&qca8k_nsscc NSS_CC_MAC3_GEPHY2_TX_CLK>,
			 <&qca8k_nsscc NSS_CC_MAC3_GEPHY2_RX_CLK>,
			 <&qca8k_nsscc NSS_CC_MAC4_TX_CLK>,
			 <&qca8k_nsscc NSS_CC_MAC4_RX_CLK>,
			 <&qca8k_nsscc NSS_CC_MAC4_GEPHY3_TX_CLK>,
			 <&qca8k_nsscc NSS_CC_MAC4_GEPHY3_RX_CLK>;
		clock-names = "mac0_tx", "mac0_rx", "mac0_tx_srds1", "mac0_rx_srds1",
			      "mac1_tx", "mac1_rx", "mac1_gephy_tx", "mac1_gephy_rx",
			      "mac2_tx", "mac2_rx", "mac2_gephy_tx", "mac2_gephy_rx",
			      "mac3_tx", "mac3_rx", "mac3_gephy_tx", "mac3_gephy_rx",
			      "mac4_tx", "mac4_rx", "mac4_gephy_tx", "mac4_gephy_rx";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				ethernet = <&gmac1>;
				phy-mode = "2500base-x";

				fixed-link {
					speed = <2500>;
					full-duplex;
				};
			};

			port@1 {
				reg = <1>;
				label = "lan1";
				phy-mode = "internal";
				phy-handle = <&ephy1>;
			};

			port@2 {
				reg = <2>;
				label = "lan2";
				phy-mode = "internal";
				phy-handle = <&ephy2>;
			};

			port@3 {
				reg = <3>;
				label = "lan3";
				phy-mode = "internal";
				phy-handle = <&ephy3>;
			};

			/* phy4 is the physical "Internet" socket on this board. */
			port@4 {
				reg = <4>;
				label = "wan";
				phy-mode = "internal";
				phy-handle = <&ephy4>;
			};
		};
	};
};

&pcie0_phy {
	status = "okay";
};

&pcie0 {
	status = "okay";

	perst-gpios = <&tlmm 15 GPIO_ACTIVE_LOW>;

	pcie@0 {
		wifi@0,0 {
			status = "okay";

			/* QCN9074: ath11k lacks DT compatible for PCI cards */
			compatible = "pci17cb,1104";
			reg = <0x00010000 0 0 0 0>;

			qcom,ath11k-calibration-variant = "Linksys-SPNMX56";
		};
	};
};

&q6v5_wcss {
	firmware-name = "ath11k/IPQ5018/hw1.0/q6_fw.mdt",
			"ath11k/IPQ5018/hw1.0/m3_fw.mdt";
};

&wifi {
	status = "okay";

	qcom,rproc = <&q6v5_wcss>;
	qcom,ath11k-calibration-variant = "Linksys-SPNMX56";
	qcom,ath11k-fw-memory-mode = <1>;
};
